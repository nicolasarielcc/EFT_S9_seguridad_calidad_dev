{
  "apiVersion": "1.0.0",
  "apiName": "Pet Adoption Frontend API",
  "baseUrl": "http://localhost:8080",
  "productionUrl": "https://example.com",
  "framework": "Spring Boot 3.x + Thymeleaf",
  "description": "Frontend web que consume API del backend. Incluye controladores MVC y REST.",
  "lastUpdated": "2026-05-06",

  "endpoints": [
    {
      "id": "web_home",
      "method": "GET",
      "path": "/",
      "summary": "Página principal",
      "description": "Muestra la página de inicio del sistema",
      "protected": false,
      "tags": ["Web"],
      "type": "web",
      "response": {
        "description": "HTML - Página de inicio"
      }
    },

    {
      "id": "web_login_form",
      "method": "GET",
      "path": "/login",
      "summary": "Formulario de login",
      "description": "Muestra el formulario de autenticación",
      "protected": false,
      "tags": ["Autenticación"],
      "type": "web",
      "response": {
        "description": "HTML - Formulario de login"
      }
    },

    {
      "id": "web_login_post",
      "method": "POST",
      "path": "/login",
      "summary": "Procesar login",
      "description": "Autentica usuario y genera sesión JWT en cookie",
      "protected": false,
      "tags": ["Autenticación"],
      "type": "web",
      "requestBody": {
        "required": true,
        "contentType": "application/x-www-form-urlencoded",
        "schema": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "example": "admin"
            },
            "password": {
              "type": "string",
              "format": "password",
              "example": "password123"
            }
          }
        }
      },
      "responses": {
        "302": {
          "description": "Redirect - Login exitoso",
          "location": "/"
        },
        "302_error": {
          "description": "Redirect - Login fallido",
          "location": "/login?error"
        }
      }
    },

    {
      "id": "web_logout",
      "method": "GET",
      "path": "/logout",
      "summary": "Cerrar sesión",
      "description": "Elimina la cookie JWT y cierra la sesión",
      "protected": true,
      "tags": ["Autenticación"],
      "type": "web",
      "responses": {
        "302": {
          "description": "Redirect a /login"
        }
      }
    },

    {
      "id": "web_pets_list",
