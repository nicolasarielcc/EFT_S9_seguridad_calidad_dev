      "protected": false,
      "tags": ["Mascotas"],
      "type": "web",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "response": {
        "description": "HTML - Detalle de mascota"
      }
    },

    {
      "id": "web_pets_create_form",
