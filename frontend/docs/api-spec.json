      }
    },

    {
      "id": "api_auth_login",
      "method": "POST",
      "path": "/api/auth/login",
      "summary": "Autenticar usuario",
      "description": "Autentica usuario y retorna token JWT",
      "protected": false,
      "tags": ["REST - Autenticación"],
      "type": "rest",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "example": "admin"
            },
            "password": {
              "type": "string",
              "format": "password",
              "example": "password123"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Autenticación exitosa",
          "schema": {
            "$ref": "#/components/AuthResponse"
          }
        },
        "401": {
          "description": "Credenciales inválidas"
        }
      }
    },

    {
      "id": "api_appointments_list",
      "method": "GET",
      "path": "/api/appointments",
      "summary": "Listar citas",
      "description": "Obtiene lista de todas las citas",
      "protected": true,
      "tags": ["REST - Citas"],
      "type": "rest",
      "responses": {
        "200": {
          "description": "Lista de citas",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/Appointment"
            }
          }
        }
      }
    },

    {
      "id": "api_appointments_create",
      "method": "POST",
      "path": "/api/appointments",
      "summary": "Crear cita",
      "description": "Crea una nueva cita",
      "protected": true,
      "tags": ["REST - Citas"],
      "type": "rest",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "$ref": "#/components/Appointment"
        }
      },
      "responses": {
        "201": {
          "description": "Cita creada",
          "schema": {
            "$ref": "#/components/Appointment"
          }
        }
      }
    },

    {
      "id": "api_appointments_get",
      "method": "GET",
      "path": "/api/appointments/{id}",
      "summary": "Obtener cita por ID",
      "description": "Obtiene información de una cita específica",
      "protected": true,
      "tags": ["REST - Citas"],
      "type": "rest",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "200": {
          "description": "Cita encontrada",
          "schema": {
            "$ref": "#/components/Appointment"
          }
        },
        "404": {
          "description": "Cita no encontrada"
        }
      }
    },

    {
      "id": "api_appointments_update",
      "method": "PUT",
      "path": "/api/appointments/{id}",
      "summary": "Actualizar cita",
      "description": "Actualiza información de una cita",
      "protected": true,
      "tags": ["REST - Citas"],
      "type": "rest",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "200": {
          "description": "Cita actualizada"
        }
      }
    },

    {
      "id": "api_appointments_delete",
      "method": "DELETE",
      "path": "/api/appointments/{id}",
      "summary": "Eliminar cita",
      "description": "Elimina una cita del sistema",
      "protected": true,
      "tags": ["REST - Citas"],
      "type": "rest",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "204": {
          "description": "Cita eliminada"
        }
      }
    },

    {
      "id": "api_patients_list",
      "method": "GET",
      "path": "/api/patients",
      "summary": "Listar pacientes",
      "description": "Obtiene lista de todos los pacientes",
      "protected": true,
      "tags": ["REST - Pacientes"],
      "type": "rest",
      "responses": {
        "200": {
          "description": "Lista de pacientes",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/Patient"
            }
          }
        }
      }
    },

    {
      "id": "api_patients_create",
      "method": "POST",
      "path": "/api/patients",
      "summary": "Crear paciente",
      "description": "Crea un nuevo paciente",
      "protected": true,
      "tags": ["REST - Pacientes"],
      "type": "rest",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "$ref": "#/components/Patient"
        }
      },
      "responses": {
        "201": {
          "description": "Paciente creado"
        }
      }
    },

    {
      "id": "api_patients_get",
      "method": "GET",
      "path": "/api/patients/{id}",
      "summary": "Obtener paciente por ID",
      "description": "Obtiene información de un paciente específico",
      "protected": true,
      "tags": ["REST - Pacientes"],
      "type": "rest",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "200": {
          "description": "Paciente encontrado"
        }
      }
    },

    {
      "id": "api_pets_list",
      "method": "GET",
      "path": "/api/pets",
      "summary": "Listar mascotas",
      "description": "Obtiene lista de todas las mascotas",
      "protected": false,
      "tags": ["REST - Mascotas"],
      "type": "rest",
      "responses": {
        "200": {
          "description": "Lista de mascotas",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/Pet"
            }
          }
        }
      }
    },

    {
      "id": "api_pets_create",
      "method": "POST",
      "path": "/api/pets",
      "summary": "Crear mascota",
      "description": "Crea una nueva mascota",
      "protected": true,
      "tags": ["REST - Mascotas"],
      "type": "rest",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "$ref": "#/components/Pet"
        }
      },
      "responses": {
        "201": {
          "description": "Mascota creada"
        }
      }
    },

    {
      "id": "api_pets_get",
      "method": "GET",
      "path": "/api/pets/{id}",
      "summary": "Obtener mascota por ID",
      "description": "Obtiene información de una mascota específica",
      "protected": false,
      "tags": ["REST - Mascotas"],
      "type": "rest",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "200": {
          "description": "Mascota encontrada"
        }
      }
    },

    {
      "id": "api_pets_search",
      "method": "GET",
      "path": "/api/pets/search",
      "summary": "Buscar mascotas",
      "description": "Busca mascotas por criterios (especie, género, ubicación, edad)",
      "protected": false,
      "tags": ["REST - Mascotas"],
      "type": "rest",
      "parameters": [
        {
          "name": "species",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "gender",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "location",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "age",
          "in": "query",
          "required": false,
          "type": "integer"
        }
      ],
      "responses": {
        "200": {
          "description": "Resultados de búsqueda"
        }
      }
    }
  ],

  "components": {
    "Pet": {
      "type": "object",
      "required": ["name", "species", "breed", "age", "gender"],
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Max"
        },
        "species": {
          "type": "string",
          "example": "Perro"
        },
        "breed": {
          "type": "string",
          "example": "Golden Retriever"
        },
        "age": {
          "type": "integer",
          "example": 3
        },
        "gender": {
          "type": "string",
          "enum": ["Macho", "Hembra"],
          "example": "Macho"
        },
        "location": {
          "type": "string",
          "example": "Santiago"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "status": {
          "type": "string",
          "enum": ["available", "adopted", "unavailable"],
          "default": "available"
        }
      }
    },

    "Patient": {
      "type": "object",
      "required": ["name", "species", "breed", "age", "owner"],
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Firulais"
        },
        "species": {
          "type": "string",
          "example": "Perro"
        },
        "breed": {
          "type": "string",
          "example": "Labrador"
        },
        "age": {
          "type": "integer",
          "example": 5
        },
        "owner": {
          "type": "string",
          "example": "Juan Pérez"
        }
      }
    },

    "Appointment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "patientId": {
          "type": "integer",
          "example": 1
        },
        "appointmentDate": {
          "type": "string",
          "format": "date-time",
          "example": "2026-05-15T10:30:00"
        },
        "description": {
          "type": "string",
          "example": "Consulta general"
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"],
          "example": "scheduled"
        }
      }
    },

    "Invoice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 1
        },
        "appointmentId": {
          "type": "integer",
          "example": 10
        },
        "issueDate": {
          "type": "string",
          "format": "date",
          "example": "2026-05-06"
        },
        "subtotal": {
          "type": "number",
          "example": 43000
        },
        "vatAmount": {
          "type": "number",
          "example": 8170
        },
        "total": {
          "type": "number",
          "example": 51170
        },
        "notes": {
          "type": "string",
          "example": "Paciente estable"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/InvoiceLineItem"
          }
        }
      }
    },

    "InvoiceLineItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "enum": ["SERVICE", "MEDICATION", "ADDITIONAL_CHARGE"]
        },
        "description": {
          "type": "string",
          "example": "Consulta general"
        },
        "quantity": {
          "type": "integer",
          "example": 1
        },
        "unitPrice": {
          "type": "number",
          "example": 25000
        },
        "lineTotal": {
          "type": "number",
          "example": 25000
        }
      }
    },

    "AuthRequest": {
      "type": "object",
      "required": ["username", "password"],
      "properties": {
        "username": {
          "type": "string",
          "example": "admin"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "password123"
        }
      }
    },

    "AuthResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "username": {
          "type": "string",
          "example": "admin"
        },
        "expiresIn": {
          "type": "integer",
          "example": 3600
        }
      }
    }
  }
}
