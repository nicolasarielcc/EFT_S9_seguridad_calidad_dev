      "tags": ["Mascotas"],
      "type": "web",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "response": {
        "description": "HTML - Formulario de edición"
      }
    },

    {
      "id": "web_pets_update",
      "method": "PUT",
      "path": "/pets/{id}",
      "summary": "Actualizar mascota",
      "description": "Actualiza información de una mascota",
      "protected": true,
      "tags": ["Mascotas"],
      "type": "web",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "302": {
          "description": "Redirect a /pets/{id}"
        }
      }
    },

    {
      "id": "web_pets_delete",
      "method": "DELETE",
      "path": "/pets/{id}",
      "summary": "Eliminar mascota",
      "description": "Elimina una mascota del sistema",
      "protected": true,
      "tags": ["Mascotas"],
      "type": "web",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "integer"
        }
      ],
      "responses": {
        "302": {
          "description": "Redirect a /pets"
        }
      }
    },

    {
      "id": "web_patients_list",
      "method": "GET",
      "path": "/patients",
      "summary": "Listar pacientes",
      "description": "Muestra lista de todos los pacientes",
