      "response": {
        "description": "HTML - Formulario de paciente"
      }
    },

    {
      "id": "web_patients_create",
      "method": "POST",
      "path": "/patients",
      "summary": "Crear paciente",
      "description": "Crea nuevo paciente en el sistema",
      "protected": true,
      "tags": ["Pacientes"],
      "type": "web",
      "responses": {
