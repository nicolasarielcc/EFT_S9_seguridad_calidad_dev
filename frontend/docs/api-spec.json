        }
      }
    },

    {
      "id": "web_invoices_list",
      "method": "GET",
      "path": "/invoices",
      "summary": "Listar facturas",
      "description": "Muestra lista de todas las facturas",
      "protected": true,
      "tags": ["Facturas"],
      "type": "web",
      "response": {
        "description": "HTML - Lista de facturas"
      }
    },

    {
      "id": "web_invoices_detail",
      "method": "GET",
      "path": "/invoices/{id}",
      "summary": "Detalle de factura",
      "description": "Muestra información detallada de una factura",
      "protected": true,
      "tags": ["Facturas"],
      "type": "web",
      "parameters": [
        {
          "name": "id",
          "in": "path",
