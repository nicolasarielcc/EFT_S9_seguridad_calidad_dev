      "type": "web",
      "requestBody": {
        "required": true,
        "contentType": "application/x-www-form-urlencoded"
      },
      "responses": {
        "302": {
          "description": "Redirect a /pets"
        }
      }
    },

    {
      "id": "web_pets_edit",
